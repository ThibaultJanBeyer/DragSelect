{
  "name": "example",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "install-lib": "npm i ../../DragSelect ../dist && npm --prefix ../example-ng19 run install-lib",
    "lib": "cd ../../DragSelect && yarn build && cd ../DragSelect-angular && yarn build && cd example && npm run install-lib",
    "start": "ng serve",
    "build": "ng build",
    "e2e": "playwright test",
    "verify": "npm run install-lib && playwright install chromium && ng build && npm --prefix ../example-ng19 run build && playwright test",
    "test": "npm run lib && ng build && npm --prefix ../example-ng19 run build && playwright test"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@dragselect/angular": "file:../dist",
    "dragselect": "file:../../DragSelect",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.65.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
